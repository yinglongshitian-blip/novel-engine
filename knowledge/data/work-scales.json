{
  "name": "work-scales",
  "source": "v5.3 篇幅分类功能",
  "description": "短/中/长三档篇幅方案（work_scale）。含结构规模 structure 与节奏策略 rhythm 两套绑定配置。供 init_project.py 与各 Agent 消费。",
  "core_principle": "故事是什么不因篇幅改变；故事怎么装因篇幅改变。篇幅分类依据是「节奏哲学」，不是形态参数。",
  "scales": {
    "short": {
      "label": "短篇",
      "word_range": [10000, 30000],
      "structure": {
        "has_volumes": false,
        "volume_count": 0,
        "main_line_nodes_range": [3, 5],
        "chapter_range": [3, 8],
        "chapter_word_range": [2500, 4000],
        "volume_outline": "skip"
      },
      "rhythm": {
        "strategy": "leap",
        "methodology_core": "横断面 + 一击即中",
        "opening_conflict_within": 500,
        "emotion_curve": "ascending_only",
        "allow_buffer_chapter": false,
        "climax_position": "ending",
        "chapter_hook_min": 7,
        "foreshadow_limit": 3
      }
    },
    "medium": {
      "label": "中篇",
      "word_range": [30000, 100000],
      "structure": {
        "has_volumes": true,
        "volume_count": [1, 3],
        "main_line_nodes_range": [5, 8],
        "chapter_range": [10, 30],
        "chapter_word_range": [2500, 4000],
        "volume_outline": "standard"
      },
      "rhythm": {
        "strategy": "spiral",
        "methodology_core": "针的尖锐 + 山的面积",
        "opening_conflict_within": 1000,
        "emotion_curve": "rising_with_dips",
        "allow_buffer_chapter": true,
        "climax_position": "one_third_and_late",
        "chapter_hook_min": 5,
        "foreshadow_limit": 8
      }
    },
    "long": {
      "label": "长篇",
      "word_range": [100000, null],
      "structure": {
        "has_volumes": true,
        "volume_count": [5, 7],
        "main_line_nodes_range": [10, 20],
        "chapter_range": [50, 200],
        "chapter_word_range": [2000, 2200],
        "volume_outline": "full"
      },
      "rhythm": {
        "strategy": "three_tier",
        "methodology_core": "优雅从容 + 四段式",
        "opening_conflict_within": 3000,
        "emotion_curve": "wave",
        "allow_buffer_chapter": true,
        "climax_position": "quarter_and_late",
        "chapter_hook_min": 4,
        "foreshadow_limit": null
      }
    }
  },
  "review_dimensions": {
    "short": { "enabled": "基础 6 维 + 去 AI 化", "skip": ["战力崩坏", "利益链断裂", "读者视角测试"] },
    "medium": { "enabled": "18 维（跳过长篇专属维度）", "skip": ["战力崩坏", "利益链断裂"] },
    "long": { "enabled": "18 维全量 + 读者视角测试", "skip": [] }
  },
  "tiered_loading": { "short": false, "medium": "optional_gt20", "long": true },
  "summary_compression": { "short": false, "medium": "optional", "long": true },
  "snapshot_necessity": { "short": "optional", "medium": "recommended", "long": "required" },
  "foreshadow_states": { "short": 3, "medium": 5, "long": 7 },
  "gap_warning": { "min": 20000, "max": 80000, "message": "建议扩充至 8 万字以上或压缩至 2 万字以内" }
}
