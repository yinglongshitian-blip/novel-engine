    { "name": "马甲文",         "group": "设定题材", "sentence": "长短句悬念递进", "dialogue_ratio": "25%-35%", "dialogue_target": 0.30, "wording": "多身份不同语感", "rhythm": "中快",             "temp": [0.85, 0.85] },
